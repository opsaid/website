&lt;/tr>
&lt;tr>
&lt;td>reproducible&lt;/td>
&lt;td>-&lt;/td>
&lt;td>TODO;&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>single-snapshot&lt;/td>
&lt;td>-&lt;/td>
&lt;td>TODO;&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>skip-tls-verify&lt;/td>
&lt;td>-&lt;/td>
&lt;td>push 镜像跳过 tls 验证&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>skip-tls-verify-pull&lt;/td>
