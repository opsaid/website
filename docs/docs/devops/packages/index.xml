&lt;/tr>
&lt;tr>
&lt;td>no-push&lt;/td>
&lt;td>-&lt;/td>
&lt;td>不上传至镜像中心&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>no-push-cache&lt;/td>
